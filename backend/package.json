{
  "name": "gym-membership-backend",
  "version": "1.0.0",
  "description": "Gym membership and workout tracking backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed:admin": "node src/seed/adminSeeder.js",
    "typeorm": "node ./node_modules/typeorm/cli.js",
    "migration:generate": "npm run typeorm -- migration:generate ./src/migrations/Migration",
    "migration:run": "npm run typeorm -- migration:run -d src/config/datasource.js",
    "migration:revert": "npm run typeorm -- migration:revert -d src/config/datasource.js"

  },
  "dependencies": {
    "bcrypt": "^5.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.1.13",
    "typeorm": "^0.3.17"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
